  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "TCP 必须提供；私有 Unix HTTP IPC 可省略。浏览器 cookie 需要有效 Origin。"
      }
    },
    "schemas": {
      "Host": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          },
          "connectionProfile": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "root"
        ]
      },
      "Task": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "shell",
              "run"
            ],
            "default": "shell"
          },
          "command": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "shell": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ]
      },
      "Transfer": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "upload",
              "download"
            ]
          },
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "overwrite": {
            "type": "boolean",
            "default": false
          },
          "sha256": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 40,
            "default": "未命名"
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "default": ""
          }
        },
        "required": [
          "mode",
          "path"
        ]
      },
      "Forward": {
        "type": "object",
        "properties": {
          "listen": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "tcp"
                ]
              },
              "address": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "address"
            ]
          },
          "maxConnections": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "maxLength": 40
          },
          "description": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "listen",
          "target"
        ]
      },
      "Search": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "content": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "path",
          "query"
        ]
      },
      "Preferences": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "directory": {
            "type": "string"
          },
          "options": {
            "type": "object"
          }
        },
        "required": [
          "options"
        ]
      },
      "Request": {
        "type": "object",
        "properties": {
          "executor": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "directory": {
            "type": "string"
          }
        },
        "required": [
          "tool"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
