      "post": {
        "summary": "请求停止 CLI 宿主",
        "operationId": "stop_cli_host",
        "parameters": [
          {
            "name": "X-RexETerm-Service-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        ],
        "responses": {
